# Настройки сервера. Секретов у прототипа нет: ни ключей ИИ, ни паролей сервисов.
# Скопируйте в .env при необходимости (файл .env в репозиторий не попадает).

# Порт HTTP (по умолчанию 3000)
PORT=3000

# Папка с файлом базы данных SQLite (по умолчанию ./data; на Amvera — /data)
DATA_DIR=./data

# Стоимость bcrypt (по умолчанию 11; в тестах 4)
# BCRYPT_COST=11

# Дополнительные домены, с которых разрешены изменяющие запросы (через запятую), если прокси меняет Host
# ALLOWED_HOSTS=deka.example.ru

# Подмена «сейчас» для скриншотов и демонстрации (московское время)
# DEKA_NOW=2026-11-24T10:05
